"""MetaX MM and shared GEMM compute primitives.

The host builds one Features record and one Plan for every call. A plan selects
GEMV (implemented in mv.py), GEMM (one tiled dot), or dual GEMM (two dots
sharing an operand). BMM owns its batched plan/grid and shares these arithmetic
and execution primitives; no arithmetic lives in bmm.py. Packing and deterministic
split-K execute the decisions of the calling operator's plan.
Each family has its own YAML candidates and exact stride/dtype autotune key.

Dual GEMM trades some input reuse for smaller output tiles. It is considered
when a long, aligned half-precision GEMM wastes a significant fraction of a
device wave with square tiles. Grid size is derived from the actual workload;
neither dimensions nor the number of SMs are an algorithm lookup table.

All arithmetic is Triton with FP32 accumulation and IEEE FP32 dot precision.
Warm each workload before CUDA Graph capture; first use may compile and tune.
"""

import copy
import hashlib
import logging
import os
import re
import threading
from dataclasses import dataclass
from functools import cached_property, lru_cache
from pathlib import Path
from typing import Any, Callable, NamedTuple

import torch
import triton
import triton.language as tl
from flaggems_vllm import runtime
from flaggems_vllm.runtime.backend._metax.ops.mv import _launch_narrow
from flaggems_vllm.runtime.backend._metax.ops.mv import (
    _matrix_reduce_tuned as _reduce_tuned,
)
from flaggems_vllm.runtime.backend._metax.ops.mv import _mv_out, _narrow_split_count
from flaggems_vllm.runtime.backend._metax.ops.mv import (
    _selected_config as _selected_mv_config,
)
from flaggems_vllm.runtime.backend._metax.ops.mv import _selected_narrow
from flaggems_vllm.utils import libentry, libtuner
from flaggems_vllm.utils.libentry import LibTuner

logger = logging.getLogger(__name__)


# Workload description and planning. These records contain no tensors.


@dataclass(frozen=True)
class _Hardware:
    sm_count: int
    shared_bytes: int


@lru_cache(None)
def _hardware(device):
    props = runtime.torch_device_fn.get_device_properties(device)
    return _Hardware(props.multi_processor_count, props.shared_memory_per_block)


@dataclass(frozen=True)
class _Features:
    """Exact tensor metadata plus derived layout, reuse and scheduling features."""

    batch: int
    m: int
    n: int
    k: int
    a_strides: tuple
    b_strides: tuple
    c_strides: tuple
    dtype: torch.dtype
    out_dtype: torch.dtype
    device: torch.device
    aligned: bool
    hardware: _Hardware

    @property
    def half(self):
        return self.dtype in (torch.float16, torch.bfloat16)

    @property
    def vector(self):
        return min(self.m, self.n) == 1

    @property
    def narrow_rows(self):
        # A 16-row MMA tile would use at most half its rows.
        return self.m <= 8

    @property
    def rhs_k_contiguous(self):
        return self.b_strides[1] == 1

    @property
    def reduction_tiles(self):
        return triton.cdiv(self.k, 64)

    @property
    def dense_operands(self):
        return self.a_strides[1:] == (self.k, 1) and self.b_strides[1:] in (
            (self.n, 1),
            (1, self.k),
        )

    @property
    def dense_output(self):
        return self.c_strides[1:] == (self.n, 1) and (
            self.batch == 1 or self.c_strides[0] == self.m * self.n
        )

    @property
    def vector_aligned(self):
        # Eight half elements form the 16-byte vector load used by this family.
        return self.aligned and all(
            stride == 1 or stride % 8 == 0
            for stride in self.a_strides + self.b_strides + self.c_strides
        )

    def tiles(self, rows, columns):
        return self.batch * triton.cdiv(self.m, rows) * triton.cdiv(self.n, columns)

    def wave_work(self, rows, columns, occupancy=1):
        capacity = self.hardware.sm_count * occupancy
        return triton.cdiv(self.tiles(rows, columns), capacity) * rows * columns

    def tile_utilization(self, rows, columns):
        return (
            self.batch * self.m * self.n / (self.tiles(rows, columns) * rows * columns)
        )

    def wave_utilization(self, rows, columns):
        tiles = self.tiles(rows, columns)
        slots = triton.cdiv(tiles, self.hardware.sm_count) * self.hardware.sm_count
        return tiles / slots


def _extract_features(a, b, c) -> _Features:
    return _Features(
        a.shape[0],
        a.shape[1],
        b.shape[2],
        a.shape[2],
        tuple(a.stride()),
        tuple(b.stride()),
        tuple(c.stride()),
        a.dtype,
        c.dtype,
        a.device,
        all(t.data_ptr() % 16 == 0 for t in (a, b, c)),
        _hardware(a.device),
    )


@dataclass(frozen=True)
class _Plan:
    """A compute family and its explicit workspace requirements."""

    family: str
    split_k: int = 1
    pack_rhs: bool = False


def _dual_tile_profitable(f: _Features, rows: int, columns: int) -> bool:
    # Reducing per-CTA work helps only if enough CTAs run concurrently.
    # This is a scheduling estimate, not a measured hardware occupancy counter.
    return (
        f.wave_work(128, 128) / f.wave_work(rows, columns) >= 1.15
        and f.tile_utilization(rows, columns) >= 0.85
        and f.wave_utilization(rows, columns) >= 0.85
    )


def _dual_suitable(f: _Features) -> bool:
    # Deep half-precision pipelines need contiguous vectors and enough K work.
    # Keep non-vectorizable tails on the general kernel; logical M tails remain
    # valid when physical strides are aligned and output padding is modest.
    if not (
        f.half
        and f.out_dtype == f.dtype
        and f.dense_operands
        and f.dense_output
        and f.vector_aligned
        and f.k % 64 == 0
        and f.reduction_tiles >= 32
        and min(f.m, f.n) >= 4 * 128
        and f.hardware.shared_bytes >= 52 * 1024
    ):
        return False
    # Each square/dual candidate needs > half the shared memory of an SM, so
    # estimate one resident CTA. Require >=1.15x estimated wave-work speedup
    # and >=85% utilization of both output lanes and CTA wave slots.
    return any(_dual_tile_profitable(f, rows, columns) for rows, columns in _DUAL_TILES)


def _split_count(f: _Features) -> int:
    if f.narrow_rows and f.n >= 64 and f.reduction_tiles >= 8 and f.half:
        return min(8, triton.next_power_of_2(triton.cdiv(f.k, 128)))
    if not (
        not f.half
        and f.reduction_tiles >= 64
        and min(f.m, f.n) >= 8 * 64
        and f.a_strides[2] == 1
        and 1 in f.b_strides[1:]
    ):
        return 1
    # FP32 64x64x32 tiles use about 32 KiB shared. Wave quantization predicts
    # whether shorter K loops can pay for a second launch and FP32 workspace.
    capacity = f.hardware.sm_count * max(1, f.hardware.shared_bytes // 32768)
    tiles = f.tiles(64, 64)
    waves = triton.cdiv(tiles, capacity)
    for split, minimum_gain in ((2, 1.20), (4, 1.14)):
        if split * waves / triton.cdiv(split * tiles, capacity) >= minimum_gain:
            return split
    return 1


def _pack_profitable(f: _Features) -> bool:
    # Packing is amortized by repeated use of each B panel over many M tiles.
    # Batch is unrestricted: every batch pays for, and reuses, its own packing.
    return (
        f.half
        and f.dense_operands
        and not f.rhs_k_contiguous
        and f.m // 128 >= 8
        and f.n // 128 >= 8
        and f.reduction_tiles >= 64
        and f.m % 128 == 0
        and f.n % 128 == 0
        and f.k % 64 == 0
    )


@lru_cache(maxsize=4096)
def _make_plan(f: _Features, allow_dual: bool = True) -> _Plan:
    """MM policy; BMM has its own policy using the shared hardware/cost helpers."""
    if not f.batch or not f.m or not f.n:
        return _Plan("empty")
    if not f.k:
        return _Plan("zero")
    if f.vector or (f.narrow_rows and f.rhs_k_contiguous):
        return _Plan("gemv", _narrow_split_count(f))
    if allow_dual and _dual_suitable(f):
        return _Plan("dual_gemm")
    return _Plan("gemm", _split_count(f), _pack_profitable(f))


# Triton arithmetic families.


@triton.jit
def _gemm_kernel(
    A,
    B,
    C,
    M: tl.constexpr,
    N: tl.constexpr,
    K: tl.constexpr,
    SAB: tl.constexpr,
    SAM: tl.constexpr,
    SAK: tl.constexpr,
    SBB: tl.constexpr,
    SBK: tl.constexpr,
    SBN: tl.constexpr,
    SCB: tl.constexpr,
    SCM: tl.constexpr,
    SCN: tl.constexpr,
    BM: tl.constexpr,
    BN: tl.constexpr,
    BK: tl.constexpr,
    GROUP_M: tl.constexpr = 1,
    SPLIT_K: tl.constexpr = 1,
    BATCH: tl.constexpr = 1,
    TRANSPOSE: tl.constexpr = False,
    STATIC_K: tl.constexpr = False,
):
    """One output tile per CTA, optionally with a deterministic K partition."""
    if TRANSPOSE:
        A, B = B, A
        M, N = N, M
        SAB, SAM, SAK, SBB, SBK, SBN = SBB, SBN, SBK, SAB, SAK, SAM
        SCM, SCN = SCN, SCM
    nm, nn = tl.cdiv(M, BM), tl.cdiv(N, BN)
    batch = (tl.program_id(0) // (nm * nn * SPLIT_K)).to(tl.int64)
    split = tl.program_id(0) // (nm * nn) % SPLIT_K
    pid = tl.program_id(0) % (nm * nn)
    group = pid // (GROUP_M * nn)
    first_m = group * GROUP_M
    group_m = tl.minimum(nm - first_m, GROUP_M)
    local = pid % (GROUP_M * nn)
    pm = first_m + local % group_m
    pn = local // group_m
    mi = pm * BM + tl.arange(0, BM)
    ni = pn * BN + tl.arange(0, BN)
    iterations = tl.cdiv(K, BK * SPLIT_K)
    ki = tl.arange(0, BK) + split * iterations * BK
    ap = (
        A
        + batch * SAB
        + mi[:, None].to(tl.int64) * SAM
        + ki[None, :].to(tl.int64) * SAK
    )
    bp = (
        B
        + batch * SBB
        + ki[:, None].to(tl.int64) * SBK
        + ni[None, :].to(tl.int64) * SBN
    )
    acc = tl.zeros((BM, BN), tl.float32)
    if STATIC_K:
        # Short reductions cannot amortize a pipelined loop's prologue/epilogue.
        # Keep addresses in int64 here too, including for sliced input/output.
        for k in tl.static_range((K + BK * SPLIT_K - 1) // (BK * SPLIT_K)):
            if K % (BK * SPLIT_K) == 0:
                if M % BM == 0:
                    ak = tl.load(ap)
                else:
                    ak = tl.load(ap, mi[:, None] < M, other=0)
                if N % BN == 0:
                    bk = tl.load(bp)
                else:
                    bk = tl.load(bp, ni[None, :] < N, other=0)
            else:
                ak = tl.load(
                    ap, (mi[:, None] < M) & (ki[None, :] + k * BK < K), other=0
                )
                bk = tl.load(
                    bp, (ki[:, None] + k * BK < K) & (ni[None, :] < N), other=0
                )
            acc = tl.dot(ak, bk, acc, input_precision="ieee")
            ap += BK * SAK
            bp += BK * SBK
    else:
        for k in range(iterations):
            if K % (BK * SPLIT_K) == 0:
                if M % BM == 0:
                    ak = tl.load(ap)
                else:
                    ak = tl.load(ap, mi[:, None] < M, other=0)
                if N % BN == 0:
                    bk = tl.load(bp)
                else:
                    bk = tl.load(bp, ni[None, :] < N, other=0)
            else:
                ak = tl.load(
                    ap, (mi[:, None] < M) & (ki[None, :] + k * BK < K), other=0
                )
                bk = tl.load(
                    bp, (ki[:, None] + k * BK < K) & (ni[None, :] < N), other=0
                )
            acc = tl.dot(ak, bk, acc, input_precision="ieee")
            ap += BK * SAK
            bp += BK * SBK
    cp = (
        C
        + split.to(tl.int64) * BATCH * M * N
        + batch * SCB
        + mi[:, None].to(tl.int64) * SCM
        + ni[None, :].to(tl.int64) * SCN
    )
    tl.store(cp, acc, (mi[:, None] < M) & (ni[None, :] < N))


@triton.jit
def _pack_rhs_kernel(
    A,
    T,
    R: tl.constexpr,
    C: tl.constexpr,
    SB: tl.constexpr,
    SR: tl.constexpr,
    SC: tl.constexpr,
    BR: tl.constexpr,
    BC: tl.constexpr,
    BATCH: tl.constexpr = 1,
):
    """Materialize a K-contiguous RHS using a tiled Triton copy."""
    batch = tl.program_id(1).to(tl.int64)
    row = (tl.program_id(0) // tl.cdiv(C, BC) * BR + tl.arange(0, BR)).to(tl.int64)
    col = (tl.program_id(0) % tl.cdiv(C, BC) * BC + tl.arange(0, BC)).to(tl.int64)
    mask = (row[:, None] < R) & (col[None, :] < C)
    value = tl.load(
        A + batch * SB + row[:, None] * SR + col[None, :] * SC, mask, other=0
    )
    tl.store(T + batch * R * C + row[:, None] + col[None, :] * R, value, mask)


@triton.jit
def _zero_kernel(
    C,
    M: tl.constexpr,
    N: tl.constexpr,
    TOTAL: tl.constexpr,
    SCB: tl.constexpr,
    SCM: tl.constexpr,
    SCN: tl.constexpr,
    BLOCK: tl.constexpr,
):
    """Fill a potentially strided output for the K=0 identity."""
    i = tl.program_id(0).to(tl.int64) * BLOCK + tl.arange(0, BLOCK)
    offset = i // (M * N) * SCB + (i // N % M) * SCM + (i % N) * SCN
    tl.store(C + offset, 0.0, i < TOTAL)


@triton.jit
def _dual_gemm_kernel(
    A,
    B,
    C,
    M: tl.constexpr,
    N: tl.constexpr,
    K: tl.constexpr,
    SAB: tl.constexpr,
    SAM: tl.constexpr,
    SAK: tl.constexpr,
    SBB: tl.constexpr,
    SBK: tl.constexpr,
    SBN: tl.constexpr,
    SCB: tl.constexpr,
    SCM: tl.constexpr,
    SCN: tl.constexpr,
    BM: tl.constexpr,
    B0: tl.constexpr,
    B1: tl.constexpr,
    BK: tl.constexpr,
    SWAP: tl.constexpr = False,
    GROUP_M: tl.constexpr = 1,
    BATCH: tl.constexpr = 1,
    LAYOUT: tl.constexpr = 0,
):
    """Two power-of-two dots share A, forming a narrower non-power-of-two tile.

    SWAP computes C^T = B^T A^T, with stores through the original output strides.
    LAYOUT identifies an optional compiler-layout candidate during autotuning.
    """
    if SWAP:
        A, B = B, A
        M, N = N, M
        SAB, SAM, SAK, SBB, SBK, SBN = SBB, SBN, SBK, SAB, SAK, SAM
        SCM, SCN = SCN, SCM
    nn = tl.cdiv(N, B0 + B1)
    nm = tl.cdiv(M, BM)
    pid = tl.program_id(0)
    if BATCH > 1:
        batch = (pid // (nm * nn)).to(tl.int64)
        A += batch * SAB
        B += batch * SBB
        C += batch * SCB
        pid = pid % (nm * nn)
    group = pid // (GROUP_M * nn)
    first_m = group * GROUP_M
    group_m = tl.minimum(nm - first_m, GROUP_M)
    local = pid % (GROUP_M * nn)
    pm = first_m + local % group_m
    pn = local // group_m
    m = pm * BM + tl.arange(0, BM)
    n0 = pn * (B0 + B1) + tl.arange(0, B0)
    n1 = pn * (B0 + B1) + B0 + tl.arange(0, B1)
    k = tl.arange(0, BK)
    ap = A + m[:, None].to(tl.int64) * SAM + k[None, :].to(tl.int64) * SAK
    bp0 = B + k[:, None].to(tl.int64) * SBK + n0[None, :].to(tl.int64) * SBN
    bp1 = B + k[:, None].to(tl.int64) * SBK + n1[None, :].to(tl.int64) * SBN
    c0 = tl.zeros((BM, B0), tl.float32)
    c1 = tl.zeros((BM, B1), tl.float32)
    for it in range(triton.cdiv(K, BK)):
        av = tl.load(ap, (m[:, None] < M) & (k[None, :] + it * BK < K), 0)
        b0 = tl.load(bp0, (n0[None, :] < N) & (k[:, None] + it * BK < K), 0)
        b1 = tl.load(bp1, (n1[None, :] < N) & (k[:, None] + it * BK < K), 0)
        c0 = tl.dot(av, b0, c0, input_precision="ieee")
        c1 = tl.dot(av, b1, c1, input_precision="ieee")
        ap += BK * SAK
        bp0 += BK * SBK
        bp1 += BK * SBK
    p0 = C + m[:, None].to(tl.int64) * SCM + n0[None, :].to(tl.int64) * SCN
    p1 = C + m[:, None].to(tl.int64) * SCM + n1[None, :].to(tl.int64) * SCN
    tl.store(p0, c0, (m[:, None] < M) & (n0[None, :] < N))
    tl.store(p1, c1, (m[:, None] < M) & (n1[None, :] < N))


# Per-family tuning and compiler constraints.


def _prune_gemm(configs, named_args, **kwargs):
    args = {**named_args, **kwargs}
    m, n, k = args["M"], args["N"], args["K"]
    size = args["A"].element_size()
    result = []
    for config in configs:
        meta = config.kwargs
        if meta.get("STATIC_K", False) and (
            k > 128 or min(m, n) < 64 or args.get("SPLIT_K", 1) != 1
        ):
            continue
        mt, nt = (n, m) if meta.get("TRANSPOSE", False) else (m, n)
        bm, bn, bk = meta["BM"], meta["BN"], meta["BK"]
        if meta.get("scenario") == "unprefetch" and (mt % bm or nt % bn or k % bk):
            # Masked edges make this layout spill heavily with deeper stages.
            # Keep the original general-purpose candidates for those workloads.
            continue
        if (
            size == 4
            and args.get("SPLIT_K", 1) > 1
            and k % (bk * args["SPLIT_K"]) != 0
            and meta.get("pipeline", "basic").startswith("cpasync")
        ):
            # This FlagTree backend's genSwiMask asserts on the masked FP32
            # split-K async pipeline. The basic pipeline handles the same tail.
            continue
        if meta.get("STATIC_K", False) and bm != bn and size != 4:
            continue
        if bm > max(32, triton.next_power_of_2(mt)) or bn > max(
            32, triton.next_power_of_2(nt)
        ):
            continue
        if bk > max(32, triton.next_power_of_2(k)):
            continue
        if (bm + bn) * bk * size * min(config.num_stages, 2) > 65536:
            continue
        if config.num_stages > 2 and k <= bk:
            continue
        # This 8-warp layout is useful for long reductions with both K axes
        # contiguous. Other orientations use the smaller, lower-pressure tiles.
        if bm == 128 and bn == 128 and config.num_warps == 8:
            if k < 512 or args["SAK"] != 1 or args["SBK"] != 1:
                continue
        if meta.get("TRANSPOSE", False):
            if meta.get("STATIC_K", False):
                # Both inputs are contiguous in K. Swapping the dot operands
                # changes the output layout without materializing a transpose.
                if size != 2 or args["SAK"] != 1 or args["SBK"] != 1:
                    continue
            elif not (
                args["SAM"] == 1 or (args["SBN"] == 1 and k <= 256 and min(m, n) >= 64)
            ):
                continue
        # FlagTree's AABS mutates a config while benchmarking it. Keep the YAML
        # candidate pool intact so a tiny first call cannot shrink later GEMMs.
        result.append(copy.deepcopy(config))
    return result


def _prune_dual(configs, named_args, **kwargs):
    args = {**named_args, **kwargs}
    features = _extract_features(args["A"], args["B"], args["C"])
    result = []
    for config in configs:
        meta = config.kwargs
        rows, columns = meta["B0"] + meta["B1"], meta["BM"]
        if not _dual_tile_profitable(features, rows, columns):
            continue
        if meta["LAYOUT"] and not _layout_adapter_supported():
            continue
        result.append(copy.deepcopy(config))
    return result


def _graph_bench(fn, quantiles):
    # Use the same device execution mode as deployment, including short kernels.
    return triton.testing.do_bench_cudagraph(fn, rep=20, quantiles=quantiles)


class _KernelTuner(LibTuner):
    """Benchmark explicit tiles; prevent AABS from mutating them into invalid MMA layouts."""

    @cached_property
    def cache_key(self):
        return hashlib.sha256(
            (super().cache_key + "features_graph20_v1").encode()
        ).hexdigest()

    def _bench(self, *args, config, **meta):
        options = {**meta, **config.all_kwargs()}
        options["warmup"] = False
        try:
            return self.do_bench(
                lambda: self.fn.run(*args, **options), quantiles=(0.5, 0.2, 0.8)
            )
        except triton.OutOfResources:
            return [float("inf")] * 3

    def policy(self, bench, configs, args, kwargs):
        timings = {config: bench(config) for config in configs}
        if not timings or min(timings.values())[0] == float("inf"):
            raise RuntimeError("no bmm candidate fits this workload and device")
        return min(timings, key=timings.get), timings


class _LaunchError(RuntimeError):
    """A benchmark execution failure must never become a compiler fallback."""


class _DualTuner(_KernelTuner):
    """Time the final compiled candidate, including its optional layout adapter."""

    @cached_property
    def kernel_hash(self):
        # Re-select winners after wave pruning; per-config timing remains valid.
        return hashlib.md5((super().kernel_hash + "wave_fill_v1").encode()).hexdigest()

    def _bench(self, *args, config, **meta):
        try:
            compiled = _compile_dual(args, {**meta, **config.all_kwargs()})
            if compiled.kernel.n_spills:
                return [float("inf")] * 3
        except Exception as error:
            # Candidate compilation only. Launch errors below must propagate.
            logger.debug("MetaX dual GEMM candidate unavailable: %s", error)
            return [float("inf")] * 3
        try:
            return self.do_bench(
                lambda: compiled.launch(*args[:3]), quantiles=(0.5, 0.2, 0.8)
            )
        except Exception as error:
            raise _LaunchError("MetaX dual GEMM execution failed") from error


# Optional scoped compiler layout adaptation and compiled-code cache.


@lru_cache(None)
def _layout_adapter_supported():
    # Layout aliases are an internal ABI. Restrict this optional adapter to the
    # backend revision on which it was validated, then also validate the IR.
    compiler = Path(triton.__file__).parent / "backends/metax/compiler.py"
    return (
        triton.__version__ == "3.6.0"
        and compiler.is_file()
        and hashlib.sha256(compiler.read_bytes()).hexdigest()
        == "45b53457cd99661163eddc970c6e2e6601cd3d60ffb86b3e55467d40954d7a18"
    )


def _adapt_dot_layout(source, layout):
    mma = re.findall(r"^#mma = #ttg\.maca_mma<\{.*$", source, re.MULTILINE)
    if len(mma) != 1 or not all(
        field in mma[0]
        for field in (
            "versionMajor = 2, versionMinor = 0",
            "warpsPerCTA = [8, 1]",
            "elementsMNK = [1, 1, 4]",
            "isATrans = false, isBTrans = false",
        )
    ):
        raise ValueError("unrecognized MACA MMA layout")
    if layout == "NT":
        return source.replace(
            mma[0], mma[0].replace("elementsMNK = [1, 1, 4]", "elementsMNK = [1, 1, 8]")
        )
    shared = re.findall(r"^#shared = #ttg\.swizzled_shared<\{.*$", source, re.MULTILINE)
    if len(shared) != 1:
        raise ValueError("unrecognized MACA shared layout")
    changed = shared[0]
    for field, value in (("vec", 8), ("perPhase", 1), ("maxPhase", 8)):
        changed, count = re.subn(rf"\b{field} = \d+", f"{field} = {value}", changed)
        if count != 1:
            raise ValueError(f"unrecognized MACA shared field: {field}")
    return source.replace(shared[0], changed)


class _Executable(NamedTuple):
    runner: Callable
    constants: tuple
    kernel: Any
    layout_mode: str
    grid: tuple

    def launch(self, a, b, c):
        self.runner(a, b, c, *self.constants)


def _compile_dual(args, meta):
    """Compile only; no hidden output computation or input-data cache."""
    values = {**dict(zip(_dual_gemm_kernel.arg_names, args)), **meta}
    grid = (
        values["BATCH"]
        * triton.cdiv(values["N"], values["BM"])
        * triton.cdiv(values["M"], values["B0"] + values["B1"]),
        1,
        1,
    )
    options = {
        name: values[name]
        for name in ("num_warps", "num_stages", "pipeline", "scenario")
    }
    constants = tuple(
        values.get(p.name, p.default) for p in _dual_gemm_kernel.params[3:]
    )
    base = _dual_gemm_kernel.warmup(*args[:3], *constants, grid=grid, **options)
    compiled = _Executable(base[grid], constants, base, "source", grid)
    if (
        not values["LAYOUT"]
        or not _layout_adapter_supported()
        or "TRITON_DISABLE_SWIZZLE" in os.environ
    ):
        return compiled
    try:
        from triton.runtime.cache import get_cache_manager

        source = _adapt_dot_layout(
            base.asm["ttgir"], "NT" if values["SBK"] == 1 else "NN"
        )
        digest = hashlib.sha256(("bmm_dual_layout_v2\n" + source).encode()).hexdigest()
        cache = get_cache_manager(digest)
        path = cache.get_file("bmm_dual.ttgir")
        if path is None:
            path = cache.put(source, "bmm_dual.ttgir", binary=False)
        kernel = triton.compile(str(path), options=options)
        return _Executable(kernel[grid], (), kernel, "ttgir_layout_v2", grid)
    except Exception as error:
        logger.debug("MetaX bmm layout adapter unavailable: %s", error)
        return compiled


class _TunedExecutable(NamedTuple):
    code: _Executable
    config: triton.Config


_DUAL_CACHE = {}
_DUAL_LOCK = threading.RLock()


def _prepare_dual(f, a, b, c):
    """Tune once per metadata key; retain only code, scalar metadata and config."""
    with _DUAL_LOCK:
        if f not in _DUAL_CACHE:
            args = _matrix_args(f, a, b, c, f.b_strides, f.c_strides)
            meta = dict(BATCH=f.batch)
            grid = lambda cfg: (f.tiles(cfg["B0"] + cfg["B1"], cfg["BM"]),)
            try:
                # warmup=True selects a config and compiles the winner without
                # an extra final launch. _DualTuner benchmarks real execution.
                _dual_tuner.run(*args, **meta, grid=grid, warmup=True)
                config = _dual_tuner.best_config
                compiled = _compile_dual(args, {**meta, **config.all_kwargs()})
                _DUAL_CACHE[f] = _TunedExecutable(compiled, config)
            except _LaunchError:
                raise
            except Exception as error:
                # Every measured launch failure is wrapped in _LaunchError.
                # Only candidate selection and compilation failures reach here.
                logger.warning("MetaX dual GEMM unavailable; using GEMM: %s", error)
                _DUAL_CACHE[f] = None
            finally:
                _dual_tuner.nargs = None
        return _DUAL_CACHE[f]


_MATRIX_KEY = [
    "BATCH",
    "M",
    "N",
    "K",
    "SAB",
    "SAM",
    "SAK",
    "SBB",
    "SBK",
    "SBN",
    "SCB",
    "SCM",
    "SCN",
    "SPLIT_K",
]


def _make_tuner(kernel, name, key, prune=None, policy=_KernelTuner):
    return libtuner(
        configs=runtime.get_tuned_config(name),
        key=key,
        prune_configs_by={"early_config_prune": prune} if prune else None,
        do_bench=_graph_bench,
        rep=20,
        policy=policy,
    )(kernel)


if runtime.device.vendor_name == "metax":
    _gemm_tuned = libentry()(_make_tuner(_gemm_kernel, "bmm", _MATRIX_KEY, _prune_gemm))
    _pack_tuned = libentry()(
        _make_tuner(_pack_rhs_kernel, "bmm_pack", ["BATCH", "R", "C", "SB", "SR", "SC"])
    )
    _dual_tuner = _make_tuner(
        _dual_gemm_kernel, "bmm_dual", _MATRIX_KEY[:-1], _prune_dual, _DualTuner
    )
    _DUAL_TILES = tuple(
        sorted(
            {
                (c.kwargs["B0"] + c.kwargs["B1"], c.kwargs["BM"])
                for c in _dual_tuner.configs
            }
        )
    )


# Public API validation and execution.


def _validate_matmul(input, mat2, out_dtype, out, *, rank):
    """Validate the inference contract and return a usable output tensor."""
    if runtime.device.vendor_name != "metax":
        raise NotImplementedError("this matmul implementation targets MetaX")
    if input.layout != torch.strided or mat2.layout != torch.strided:
        raise NotImplementedError("matmul supports strided tensors only")
    if input.ndim != rank or mat2.ndim != rank:
        raise RuntimeError(f"matmul expects two rank-{rank} tensors")
    if input.shape[-1] != mat2.shape[-2] or input.shape[:-2] != mat2.shape[:-2]:
        raise RuntimeError(
            "matmul requires equal batch sizes and matching K dimensions"
        )
    if input.device != mat2.device:
        raise RuntimeError("matmul inputs must be on the same device")
    if input.device.type != "cuda":
        raise NotImplementedError("matmul is implemented for MetaX GPUs")
    if input.dtype != mat2.dtype:
        raise RuntimeError("matmul inputs must have the same dtype")
    if input.dtype not in (torch.float16, torch.bfloat16, torch.float32):
        raise NotImplementedError("matmul supports float16, bfloat16 and float32")
    dtype = input.dtype if out_dtype is None else out_dtype
    if out_dtype is not None and out_dtype != torch.float32:
        raise NotImplementedError("matmul out_dtype supports float32 only")
    if torch.is_grad_enabled() and (
        input.requires_grad
        or mat2.requires_grad
        or (out is not None and out.requires_grad)
    ):
        raise NotImplementedError("matmul direct API supports inference only")
    shape = (*input.shape[:-1], mat2.shape[-1])
    if out is not None and out.layout != torch.strided:
        raise NotImplementedError("matmul requires strided out")
    tensors = (input, mat2) if out is None else (input, mat2, out)
    if any(
        t.is_conj() or t.is_neg() or any(s < 0 for s in t.stride()) for t in tensors
    ):
        raise NotImplementedError(
            "matmul does not support lazy conjugate/negative views"
        )
    if out is None:
        return torch.empty(shape, dtype=dtype, device=input.device)
    if out.shape != shape or out.dtype != dtype or out.device != input.device:
        raise RuntimeError("matmul out must have matching shape, dtype and device")
    if out.numel():
        span = 1
        for stride, size in sorted(zip(out.stride(), out.shape)):
            if size > 1:
                if stride < span:
                    raise NotImplementedError("matmul does not support overlapping out")
                span += (size - 1) * stride
        for tensor in (input, mat2):
            if out.untyped_storage().data_ptr() == tensor.untyped_storage().data_ptr():
                raise NotImplementedError(
                    "matmul out cannot share storage with its inputs"
                )
    return out


def _matrix_args(f, a, b, target, b_strides, c_strides):
    return (a, b, target, f.m, f.n, f.k, *f.a_strides, *b_strides, *c_strides)


def _execute_matrix(plan: _Plan, f: _Features, a, b, c, *, gemm_grid=None):
    """Execute one plan; packing and reduction are visible parts of its cost."""
    if plan.family == "gemv":
        _launch_narrow(
            a,
            b,
            c,
            batch=f.batch,
            m=f.m,
            n=f.n,
            k=f.k,
            a_strides=f.a_strides,
            b_strides=f.b_strides,
            out_strides=f.c_strides,
            split_k=plan.split_k,
        )
        return
    if plan.pack_rhs:
        packed = torch.empty_strided(
            b.shape, (f.k * f.n, 1, f.k), dtype=b.dtype, device=b.device
        )
        _pack_tuned[
            lambda cfg: (
                triton.cdiv(f.k, cfg["BR"]) * triton.cdiv(f.n, cfg["BC"]),
                f.batch,
            )
        ](b, packed, f.k, f.n, *f.b_strides, BATCH=f.batch)
        b = packed
    split = plan.split_k
    partial = (
        torch.empty((split, f.batch, f.m, f.n), device=f.device, dtype=torch.float32)
        if split > 1
        else c
    )
    strides = (f.m * f.n, f.n, 1) if split > 1 else f.c_strides
    args = _matrix_args(f, a, b, partial, tuple(b.stride()), strides)

    def grid(cfg):
        if gemm_grid is not None:
            return gemm_grid(f, split, cfg)
        rows, columns = (f.n, f.m) if cfg.get("TRANSPOSE", False) else (f.m, f.n)
        return (
            split
            * f.batch
            * triton.cdiv(rows, cfg["BM"])
            * triton.cdiv(columns, cfg["BN"]),
        )

    _gemm_tuned[grid](*args, BATCH=f.batch, SPLIT_K=split)
    if split > 1:
        _reduce_tuned[lambda cfg: (triton.cdiv(c.numel(), cfg["BLOCK"]),)](
            partial, c, f.m, f.n, c.numel(), *f.c_strides, SPLIT_K=split
        )


def _selected_config(input, mat2, out, *, planner=_make_plan):
    """Explain the selected family and actual configuration without computation."""
    f = _extract_features(input, mat2, out)
    plan = planner(f)
    if plan.family == "dual_gemm":
        prepared = _DUAL_CACHE.get(f)
        if prepared is not None:
            compiled, config = prepared.code, prepared.config
            kernel = compiled.kernel
            return dict(
                algorithm=plan.family,
                split_k=1,
                grid=list(compiled.grid),
                output_tile=[
                    config.kwargs["B0"] + config.kwargs["B1"],
                    config.kwargs["BM"],
                ],
                best=str(config),
                layout_mode=compiled.layout_mode,
                shared_bytes=kernel.metadata.shared,
                registers=kernel.n_regs,
                spills=kernel.n_spills,
                binary_hash=hashlib.sha256(kernel.kernel).hexdigest(),
            )
        plan = planner(f, allow_dual=False)
    if plan.family in ("empty", "zero"):
        return dict(algorithm=plan.family)
    if plan.family == "gemv":
        return _selected_narrow(f, plan.split_k)
    split = plan.split_k
    strides = (f.m * f.n, f.n, 1) if split > 1 else f.c_strides
    b_strides = (f.k * f.n, 1, f.k) if plan.pack_rhs else f.b_strides
    key = (f.batch, f.m, f.n, f.k, *f.a_strides, *b_strides, *strides, split)
    key += (
        str(f.dtype),
        str(f.dtype),
        str(torch.float32 if split > 1 else f.out_dtype),
    )
    tuner = _gemm_tuned.fn
    result = dict(algorithm=plan.family, split_k=split, best=str(tuner.cache[key]))
    if plan.pack_rhs:
        key = (f.batch, f.k, f.n, *f.b_strides, str(f.dtype), str(f.dtype))
        result["pack_b"] = str(_pack_tuned.fn.cache[key])
        result["pack_workspace_bytes"] = f.batch * f.k * f.n * input.element_size()
    if split > 1:
        key = (
            f.m,
            f.n,
            out.numel(),
            *f.c_strides,
            split,
            str(torch.float32),
            str(f.out_dtype),
        )
        result["reduce"] = str(_reduce_tuned.fn.cache[key])
    return result


def _execute_plan(plan, f, input, mat2, out, *, fallback_plan, gemm_grid=None):
    """Execute an already chosen plan; the operator owns scheduling decisions."""
    if plan.family == "empty":
        return out
    if plan.family == "zero":
        _zero_kernel[(triton.cdiv(out.numel(), 256),)](
            out,
            f.m,
            f.n,
            out.numel(),
            *f.c_strides,
            BLOCK=256,
            num_warps=4,
        )
    elif plan.family == "dual_gemm":
        prepared = _prepare_dual(f, input, mat2, out)
        if prepared is not None:
            prepared.code.launch(input, mat2, out)
        else:
            _execute_matrix(fallback_plan(), f, input, mat2, out, gemm_grid=gemm_grid)
    else:
        _execute_matrix(plan, f, input, mat2, out, gemm_grid=gemm_grid)
    return out


def _mm_out(input, mat2, out):
    """Shared checked-out entry for MM and batch-one BMM; views only."""
    if mat2.shape[1] == 1:
        _mv_out(input, mat2[:, 0], out[:, 0])
    elif input.shape[0] == 1:
        _mv_out(mat2.T, input[0], out[0])
    else:
        a, b, c = input.unsqueeze(0), mat2.unsqueeze(0), out.unsqueeze(0)
        features = _extract_features(a, b, c)
        _execute_plan(
            _make_plan(features),
            features,
            a,
            b,
            c,
            fallback_plan=lambda: _make_plan(features, allow_dual=False),
        )
    return out


def mm(input, mat2, out_dtype=None, *, out=None):
    """Inference MM with FP32 accumulation, explicit strides and optional FP32 out."""
    out = _validate_matmul(input, mat2, out_dtype, out, rank=2)
    with runtime.torch_device_fn.device(input.device):
        return _mm_out(input, mat2, out)


def _selected_mm_config(input, mat2, out):
    if mat2.shape[1] == 1:
        return _selected_mv_config(input, mat2[:, 0], out[:, 0])
    if input.shape[0] == 1:
        return _selected_mv_config(mat2.T, input[0], out[0])
    return _selected_config(input.unsqueeze(0), mat2.unsqueeze(0), out.unsqueeze(0))
